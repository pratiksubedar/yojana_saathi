# ==============================================================================
# Yojana Saathi (योजना साथी) - Backend Configuration
# ==============================================================================

# Application Metadata
PROJECT_NAME="Yojana Saathi API"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=true

# API Prefix
API_V1_PREFIX="/api/v1"

# CORS Configuration (Origins allowed to access the backend API)
# In development, permits the local Vite React frontend
CORS_ORIGINS='["http://localhost:5173", "http://127.0.0.1:5173"]'

# Database Configuration (Zero-cost local SQLite for MVP)
DATABASE_URL="sqlite+aiosqlite:///./app.db"

# LLM Provider Gateway Configuration
# Supported options: "groq" (cloud provider), "deterministic" (local baseline), "ollama" (local)
LLM_PRIMARY_PROVIDER="groq"
LLM_SECONDARY_PROVIDER=""

# Ollama Local AI Configuration (Optional - Requires local Ollama daemon)
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="llama3.2:3b"
OLLAMA_TIMEOUT_SECONDS=10.0

# Groq Cloud LLM API Configuration (Backend Only)
# Configurable model ID; default candidate primary model is "openai/gpt-oss-120b"
# Leave GROQ_API_KEY empty for 100% zero-cost offline deterministic local operation
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"
GROQ_TIMEOUT_SECONDS=12.0
GROQ_NLU_TIMEOUT_SECONDS=6.0
GROQ_SYNTHESIS_TIMEOUT_SECONDS=7.0

